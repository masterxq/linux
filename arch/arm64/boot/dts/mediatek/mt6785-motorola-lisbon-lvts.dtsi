					hysteresis = <2000>;
					type = "hot";
				};

				cpu-lit2-crit {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-cpu-little {
					trip = <&cpu_lit2_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-cpu-little {
					trip = <&cpu_lit2_throttle>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-cpu-big {
					trip = <&cpu_lit2_throttle>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-gpu {
					trip = <&cpu_lit2_throttle>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts MT6785_GPU0>;

			trips {
				gpu0_alert: gpu0-alert {
					temperature = <65000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu0_throttle: gpu0-throttle {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu0-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "hot";
				};

				gpu0-crit {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-gpu {
					trip = <&gpu0_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-cpu-little {
					trip = <&gpu0_throttle>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-cpu-big {
					trip = <&gpu0_throttle>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-gpu {
					trip = <&gpu0_throttle>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts MT6785_GPU1>;

			trips {
				gpu1_alert: gpu1-alert {
					temperature = <65000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu1_throttle: gpu1-throttle {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				gpu1-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "hot";
				};

				gpu1-crit {
					temperature = <110000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map-gpu {
					trip = <&gpu1_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-cpu-little {
					trip = <&gpu1_throttle>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-cpu-big {
					trip = <&gpu1_throttle>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map-all-gpu {
					trip = <&gpu1_throttle>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		vpu-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts MT6785_VPU>;

			trips {
				vpu-hot {
					temperature = <95000>;
					hysteresis = <2000>;
